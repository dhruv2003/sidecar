PORT=3081
HOST=127.0.0.1
CODEX_COMMAND=codex
CODEX_STATE_ROOT=data/codex-users
CODEX_WORKSPACE_ROOT=workspaces
# Models are discovered from the Codex CLI automatically. Set these only to pin a fixed list.
# CODEX_MODELS=gpt-6.2-sol,gpt-6.2-astra,gpt-6-luna
# CODEX_IMAGE_MODELS=gpt-6.2-sol,gpt-6.2-astra,gpt-6-luna
# CODEX_MODEL_EFFORTS={"gpt-6.2-sol":["low","medium","high","xhigh","max","ultra"]}
CODEX_MAX_CONCURRENT=2
CODEX_MAX_CONCURRENT_PER_KEY=1
CODEX_MAX_QUEUE=20
CODEX_REQUEST_TIMEOUT_MS=600000
CODEX_SHUTDOWN_GRACE_MS=30000
